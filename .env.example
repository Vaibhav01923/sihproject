# PostgreSQL. DATABASE_URL is the pooled "Transaction" connection string
# (port 6543) used at runtime by every request - append
# ?pgbouncer=true&connection_limit=10&pool_timeout=20 (connection_limit=1
# is tempting but over-serializes real concurrent traffic within one warm
# serverless instance; 10 is enough headroom without overwhelming the
# pooler). DIRECT_URL is used only for running migrations - on Supabase,
# use the "Session" pooler connection (same pooler host, port 5432), NOT
# the direct db.<ref>.supabase.co host: that one is IPv6-only on newer
# projects, which most serverless build environments (Vercel included)
# can't reach, and migrations will fail with a P1001 "can't reach database
# server" error. Both strings are on Project Settings -> Database -> Connection string.
DATABASE_URL=""
DIRECT_URL=""

# Signs session JWTs. Set a long random string in production, e.g.
# `openssl rand -base64 32` - do not reuse the local dev value below.
JWT_SECRET="dev-secret-change-me"

# Optional. If unset, Quiz Studio and the AI tutor fall back to a heuristic
# (non-LLM) mode so the app is still fully functional out of the box.
OPENAI_API_KEY=""
# Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=""

# --- iGOT Karmayogi connector -----------------------------------------
# Real government sandbox credentials are not publicly self-serve, so this
# connector runs in SIMULATED mode by default (lib/igot/client.ts): it
# returns realistic mock catalog/sync data with an artificial delay and
# logs every call it *would* make. Setting these two switches the
# connector to live mode against a real iGOT API base URL.
IGOT_API_BASE_URL=""
IGOT_API_KEY=""
