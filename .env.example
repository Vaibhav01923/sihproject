# PostgreSQL. DATABASE_URL should be the pooled/transaction connection
# string (used at runtime by every request); DIRECT_URL is the direct
# connection, used only when running migrations. On Supabase these are the
# "Transaction" (port 6543, ?pgbouncer=true) and "Session"/direct (port
# 5432) connection strings from Project Settings -> Database.
DATABASE_URL=""
DIRECT_URL=""

# Signs session JWTs. Set a long random string in production, e.g.
# `openssl rand -base64 32` - do not reuse the local dev value below.
JWT_SECRET="dev-secret-change-me"

# Optional. If unset, Quiz Studio and the AI tutor fall back to a heuristic
# (non-LLM) mode so the app is still fully functional out of the box.
OPENAI_API_KEY=""
# Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=""

# --- iGOT Karmayogi connector -----------------------------------------
# Real government sandbox credentials are not publicly self-serve, so this
# connector runs in SIMULATED mode by default (lib/igot/client.ts): it
# returns realistic mock catalog/sync data with an artificial delay and
# logs every call it *would* make. Setting these two switches the
# connector to live mode against a real iGOT API base URL.
IGOT_API_BASE_URL=""
IGOT_API_KEY=""
